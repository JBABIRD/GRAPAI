{
  "_meta": {
    "title": "Erase / outpaint (laptop, 8 GB)",
    "model": "FLUX.2 klein 4B (Apache-2.0)",
    "files": {
      "diffusion_models": "flux-2-klein-4b-fp8.safetensors",
      "text_encoders": "qwen_3_4b.safetensors",
      "vae": "flux2-vae.safetensors"
    },
    "note": "True inpainting with the image as reference: VAEEncode -> SetLatentNoiseMask, DifferentialDiffusion for a soft edge, ReferenceLatent keeps the scene consistent, ImageCompositeMasked keeps unmasked pixels exact. The mask must be an RGB PNG (LoadImageMask reads the red channel). The reference is the original image only (for outpaint, without the stretched border), so the model does not copy the padding.",
    "megapixels": 1.0,
    "placeholders": [
      "image",
      "mask",
      "reference",
      "prompt",
      "width",
      "height",
      "seed",
      "ref1 (optional)"
    ],
    "optional": {
      "ref1": {
        "drop": [
          "40",
          "41"
        ],
        "bypass": {
          "42": "conditioning"
        }
      }
    }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-4b-fp8.safetensors",
      "weight_dtype": "default"
    }
